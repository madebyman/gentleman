#
# Gentleman
#

# --- Gentleman App ---
# GENTLEMAN_APP_NAME=Gentleman
# GENTLEMAN_APP_ORIGIN=http://localhost:8000
# GENTLEMAN_APP_AGENTS_DIR=agents
# GENTLEMAN_APP_EXPOSE='["agui","a2a","mcp"]'

# --- Gentleman Remote---
# GENTLEMAN_REMOTE_MAX_HOP=8

# --- Gentleman Cors---
# GENTLEMAN_CORS_ALLOW_ORIGINS='["*"]'

# --- Gentleman MCP ---
# GENTLEMAN_MCP_ALLOWED_HOSTS='[]'
# GENTLEMAN_MCP_ALLOWED_ORIGINS='[]'

#
# Providers
#

# --- OpenAI ---
# OPENAI_API_KEY=

# --- Ollama (uses the openai extra) ---
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Anthropic: requires gentleman-agents[anthropic] ---
# ANTHROPIC_API_KEY=

# --- Google (Gemini API): requires gentleman-agents[google] ---
# GOOGLE_API_KEY=

# --- Google Cloud (Vertex AI): requires gentleman-agents[google] ---
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=
# GOOGLE_APPLICATION_CREDENTIALS=

# --- Amazon Bedrock: requires gentleman-agents[bedrock] ---
# AWS_DEFAULT_REGION=
# AWS_BEARER_TOKEN_BEDROCK=

# --- xAI: requires gentleman-agents[xai] ---
# XAI_API_KEY=
