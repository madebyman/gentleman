{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "gentleman",
  "description": "Declarative AI agent server — MCP for tools, A2A for agents, AG-UI for humans.",
  "type": "object",
  "properties": {
    "global": {
      "description": "Values shared with parent charts.",
      "type": "object"
    },

    "replicaCount": {
      "description": "Number of replicas. Ignored when autoscaling is enabled.",
      "type": "integer",
      "minimum": 0
    },
    "autoscaling": {
      "description": "HorizontalPodAutoscaler.",
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": ["integer", "null"], "minimum": 1 },
        "targetMemoryUtilizationPercentage": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": {
          "description": "Defaults to the chart appVersion when empty.",
          "type": "string"
        },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },

    "podAnnotations": { "type": "object", "additionalProperties": { "type": "string" } },
    "podLabels": { "type": "object", "additionalProperties": { "type": "string" } },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },

    "appOrigin": {
      "description": "Public origin gentleman advertises. Derived from the first ingress host when empty, falling back to http://localhost:8000.",
      "type": "string",
      "pattern": "^(|https?://[^/]+)$"
    },
    "env": {
      "description": "Environment variables (GENTLEMAN_*).",
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    },
    "extraEnv": {
      "description": "Additional env entries, as in a container spec.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "value": { "type": ["string", "number", "boolean"] },
          "valueFrom": { "type": "object" }
        },
        "required": ["name"]
      }
    },

    "startupProbe": {
      "description": "Holds off liveness and readiness until startup (MCP servers included) completes.",
      "type": ["object", "null"]
    },
    "livenessProbe": { "type": ["object", "null"] },
    "readinessProbe": { "type": ["object", "null"] },
    "resources": { "type": "object" },

    "extraVolumes": { "type": "array", "items": { "type": "object" } },
    "extraVolumeMounts": { "type": "array", "items": { "type": "object" } },
    "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
    "affinity": { "type": "object" },
    "tolerations": { "type": "array", "items": { "type": "object" } },

    "secrets": {
      "description": "Model provider credentials, loaded into the container with envFrom.",
      "type": "object",
      "properties": {
        "existingSecret": {
          "description": "Name of an existing Secret. Takes precedence over create/data.",
          "type": "string"
        },
        "create": { "type": "boolean" },
        "data": {
          "description": "Key/value pairs for the created Secret. Requires create: true.",
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },

    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer", "ExternalName"]
        },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "targetPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },

    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "host": { "type": "string" },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": { "type": "string" },
                    "pathType": {
                      "type": "string",
                      "enum": ["Exact", "Prefix", "ImplementationSpecific"]
                    }
                  },
                  "required": ["path"]
                }
              }
            },
            "required": ["host"]
          }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "secretName": { "type": "string" },
              "hosts": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },

    "httpRoute": {
      "description": "Gateway API HTTPRoute.",
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "parentRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "namespace": { "type": "string" },
              "sectionName": { "type": "string" },
              "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
            },
            "required": ["name"]
          }
        },
        "hostnames": {
          "description": "Templated with tpl.",
          "type": "array",
          "items": { "type": "string" }
        },
        "path": { "type": "string" },
        "pathType": {
          "type": "string",
          "enum": ["Exact", "PathPrefix", "RegularExpression"]
        },
        "timeouts": {
          "description": "Timeouts for the generated rule. Raise these for long-lived SSE connections. Ignored when rules is set.",
          "type": "object",
          "properties": {
            "request": { "type": "string" },
            "backendRequest": { "type": "string" }
          }
        },
        "rules": {
          "description": "Replaces the generated rule entirely. Templated with tpl.",
          "type": "array",
          "items": { "type": "object" }
        }
      }
    },

    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "automount": { "type": "boolean" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "name": { "type": "string" }
      }
    },

    "agentsMountPath": {
      "description": "Where agent directories are mounted. An emptyDir is laid here, with one ConfigMap per agent on top.",
      "type": "string",
      "pattern": "^/"
    },
    "agents": {
      "description": "Your agents, keyed by agent name. One ConfigMap is created per agent. When set, defaultAgents is ignored.",
      "$ref": "#/definitions/agents"
    },
    "existingAgents": {
      "description": "Agents from ConfigMaps you manage, as agent name: ConfigMap name. Their keys become the files in the agent's directory. When set, defaultAgents is ignored.",
      "type": "object",
      "propertyNames": { "$ref": "#/definitions/agentName" },
      "additionalProperties": {
        "type": "string",
        "maxLength": 253,
        "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
      }
    },
    "defaultAgents": {
      "description": "Used only when agents and existingAgents are both empty. Set to null to mount no agents at all.",
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/definitions/agents" }
      ]
    }
  },

  "definitions": {
    "agentName": {
      "description": "The agent's directory name under agentsMountPath. gentleman skips directories starting with '.'.",
      "type": "string",
      "pattern": "^[^./][^/]*$"
    },
    "agents": {
      "type": "object",
      "propertyNames": { "$ref": "#/definitions/agentName" },
      "additionalProperties": { "$ref": "#/definitions/agentDir" }
    },
    "agentDir": {
      "description": "The files of one agent directory: agent.yaml or a2a.yaml, and optionally mcp_config.json (with agent.yaml).",
      "type": "object",
      "properties": {
        "agent.yaml": { "$ref": "#/definitions/agent" },
        "a2a.yaml": { "$ref": "#/definitions/remoteAgent" },
        "mcp_config.json": { "$ref": "#/definitions/mcpConfig" }
      },
      "additionalProperties": false,
      "anyOf": [
        { "required": ["agent.yaml"] },
        { "required": ["a2a.yaml"] }
      ],
      "allOf": [
        { "not": { "required": ["agent.yaml", "a2a.yaml"] } },
        { "not": { "required": ["a2a.yaml", "mcp_config.json"] } }
      ]
    },
    "agent": {
      "description": "A gentleman agent definition (agent.yaml).",
      "type": "object",
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "instructions": { "type": "string" },
        "routing": {
          "type": "object",
          "properties": {
            "visibility": { "type": "string", "enum": ["public", "private"] },
            "delegates": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "metadata": { "type": "object" }
      },
      "required": ["model"]
    },
    "remoteAgent": {
      "description": "A remote agent over A2A (a2a.yaml).",
      "type": "object",
      "properties": {
        "url": { "type": "string", "pattern": "^https?://" },
        "description": { "type": "string" },
        "headers": { "type": "object", "additionalProperties": { "type": "string" } },
        "timeout": { "type": "number", "exclusiveMinimum": 0 },
        "routing": {
          "type": "object",
          "properties": {
            "visibility": { "type": "string", "enum": ["public", "private"] }
          },
          "additionalProperties": false
        },
        "metadata": { "type": "object" }
      },
      "required": ["url"]
    },
    "mcpConfig": {
      "description": "MCP servers for the agent (mcp_config.json).",
      "type": "object",
      "properties": {
        "mcpServers": { "type": "object", "additionalProperties": { "type": "object" } }
      }
    }
  }
}
